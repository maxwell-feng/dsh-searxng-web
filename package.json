{
  "name": "dsh-searxng-web",
  "version": "1.0.0",
  "description": "dsh plugin: back the native web_search / web_fetch tools with your self-hosted SearXNG instance - keyless, private, no third-party search vendor.",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "src",
    "tsconfig.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CONFIG.md",
    "CONFIG.zh.md",
    "INSTALL.md",
    "INSTALL.zh.md",
    "USAGE.md",
    "USAGE.zh.md",
    "UPDATE.md",
    "UPDATE.zh.md",
    "UNINSTALL.md",
    "UNINSTALL.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "searxng",
    "web-search",
    "self-hosted",
    "privacy"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwell-feng/dsh-searxng-web.git"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.1.5-rc.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-web": "^0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
